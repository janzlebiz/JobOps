# Supabase (Public / Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Server-only — NEVER expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (Server-only: openai | anthropic | deterministic)
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Worker Dispatch Secret (Server-only)
WORKER_DISPATCH_SECRET=replace-with-strong-random-secret

# Optional Source Connectors (Server-only)
UPWORK_ACCESS_TOKEN=
FREELANCER_OAUTH_TOKEN=
ONLINEJOBS_FEED_URL=
